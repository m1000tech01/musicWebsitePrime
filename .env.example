# Contentful Content Delivery API credentials.
# Copy this file to `.env` and fill in the real values (the .env file is gitignored).
#
#   cp .env.example .env
#
# Find these in Contentful: Settings → API keys → (your key).

VITE_CONTENTFUL_SPACE_ID=your_space_id_here
VITE_CONTENTFUL_ACCESS_TOKEN=your_delivery_token_here
VITE_CONTENTFUL_ENVIRONMENT=master
